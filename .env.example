# Application
# Public origin used for webhook URLs. Must be the deployed https domain in production.
APP_URL=http://localhost:3000
NODE_ENV=development

# Session signing (generate with: openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# AES-256-GCM key for workspace secrets (64 hex chars). Required in production.
# openssl rand -hex 32
ENCRYPTION_KEY=

# Local SQLite. Production MUST use PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/workflow_os
DATABASE_URL=file:./data/workflow-os.db
# DATABASE_POOL_MAX=8
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# SpaceXAI / xAI — server-side only, never expose to the browser
# https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Optional additional providers (architecture is ready; leave empty to hide from picker)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Demo account (password is never hardcoded for production — set both explicitly)
DEMO_EMAIL=maya.chen@northstar.example
DEMO_PASSWORD=workflow-os-demo

# Dev convenience. Must NOT be true in production.
SEED_ON_BOOT=true
WORKER_POLL_MS=750
# WORKER_LOCK_MS=300000
# WORKER_CONCURRENCY=4
# Shared secret for POST/GET /api/ops/worker/tick (Vercel Cron uses CRON_SECRET).
# WORKER_SECRET=

# Production: keep the worker as a separate process (npm run worker).
# ENABLE_EMBEDDED_WORKER=true
# DISABLE_EMBEDDED_WORKER=true

# Public signup. Defaults to off in production.
# ALLOW_SIGNUP=false

# Run executions inside the web process after enqueue. Defaults to off in production.
# EXECUTE_INLINE=false

# Session cookies are Secure in production (HTTPS required). Set false only for a temporary HTTP demo.
# COOKIE_SECURE=false

# Blockchain verification layer. PostgreSQL remains the source of application data.
# Only hashes and identifiers are anchored — never inputs, outputs, secrets, or PII.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_MODE=demo
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_CONTRACT_ADDRESS=
CHAIN_PRIVATE_KEY=
CHAIN_EXPLORER_URL=
VERIFY_ON_CHAIN_DEFAULT=false
# VERIFY_TEST_RUNS=false
